# TANUKI-PONEGLYPH — variables d'environnement
# Copier vers .env (jamais commité) et remplir avec les vraies valeurs.

# Supabase (compte dédié, BDD privée)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare (deploy Pages + Worker, utilisé par GitHub Actions uniquement)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Dashboard local (dashboard/server.py) — mot de passe d'accès.
# Obligatoire : le serveur refuse de démarrer sans. Choisissez une valeur longue
# et unique ; elle protège un accès en écriture à toute la base.
DASHBOARD_PASSWORD=
